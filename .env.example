# Railway 的 PostgreSQL 插件会自动注入 DATABASE_URL（无需手填）。
# 本地开发时把下面这行改成自己的连接串，然后复制本文件为 .env。
DATABASE_URL=postgresql://postgres:password@localhost:5432/fate_draw

# Railway 公网连接若要求 SSL，把它设为 require；内网连接留空即可。
DB_SSLMODE=

# 连接池最大连接数
DB_POOL_MAX=5

# CORS 白名单，多个用英文逗号分隔；开发期用 *，上线后改成你的前端域名
ALLOWED_ORIGINS=*

# 本地启动端口（Railway 会注入 PORT，不要写死）
PORT=8000
