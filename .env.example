# 模板：复制成 .env 后填写；.env 已被 .gitignore 忽略，带密码的串不要提交到 GitHub。
#
# ⚠️ postgresql://postgres:password@localhost:5432/fate_draw 只是「本机自建 PostgreSQL」
#    的占位示例，不是 Railway 的连接串。在 Railway 容器里 localhost 指 App 容器自己，
#    永远连不到数据库。
#
# 【服务部署在 Railway】不要在文件里填连接串。控制台 → App 服务 → Variables
#   → Add Reference Variable → 选 Postgres 的 DATABASE_URL，
#   面板显示为 DATABASE_URL=${{Postgres.DATABASE_URL}}，运行时由平台注入。
#   内网串形如 postgresql://postgres:***@postgres.railway.internal:5432/railway
#
# 【本机连 Railway 的库】先在 Postgres 服务 → Settings → Networking 打开 Public Access，
#   再把 Variables 里的 DATABASE_PUBLIC_URL 填到下面（不是 DATABASE_URL）：
# DATABASE_PUBLIC_URL=postgresql://postgres:真实密码@xxx.proxy.rlwy.net:12345/railway
#   公网连接必须 SSL，也可手动设置 DB_SSLMODE=require。
#
# 【本机自建 PostgreSQL】只有这时 localhost 才有效：
# DATABASE_URL=postgresql://postgres:你的密码@localhost:5432/fate_draw

DB_SSLMODE=
DB_POOL_MAX=5

# CORS 白名单（不填时代码内置默认值已包含下面这个 Netlify 域名与本地调试地址）
# 线上如需覆盖，多个用英文逗号分隔，不要带结尾斜杠：
ALLOWED_ORIGINS=https://sparkly-bombolone-ceabfb.netlify.app

PORT=8000

# 【卡片/卡组表】启动时自动建 users / cards / user_decks 三张表，并把随仓库提交的 cards_seed.json
#   （由前端 js/config.js 导出，现 53 张）幂等写入 cards 表，无需手工导数据。
#   启动日志出现「卡片种子导入完成：53 张」即成功。
#   前端页面也会调 POST /cards/import 同步一次最新卡池（按 id upsert，重复调用安全）。
#   查询：GET /cards、GET /cards/{卡片id}；卡图 image 字段按需求暂时留空。

# 【JWT 登录凭证】★ 生产必须设置一个长期固定的随机串（例如 openssl rand -hex 32），
#   不填时服务每次启动会生成临时密钥，重启后所有玩家都必须重新登录。
#   后端用标准库 hmac/hashlib 实现 HS256，不需要额外安装 PyJWT。
#   复制成 .env 后务必把下面这行填成一串随机字符（留空 = 每次重启全体掉线）。
JWT_SECRET=
# 令牌有效期（分钟），默认 10080 = 7 天；过期后前端自动退回未登录。
JWT_EXPIRE_MINUTES=10080
#
# 需要令牌：PATCH /users/{id}、PUT /users/{id}/stats、POST /users/{id}/draw、
#   POST /users/{id}/match-result、GET/PUT /users/{id}/deck。
#   令牌里的用户必须等于路径 id，否则 403（只准读写自己的数据）。
#   注册 / 登录 / 只读用户资料 / 卡池字典无需令牌（卡池同步发生在登录之前）。
